# Shiftingpartner — Apache configuration for Hostinger (public_html/.htaccess)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect www to the bare domain (canonical host = https://shiftingpartner.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Force HTTPS (enable after SSL is active in hPanel)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Homepage has one URL: /index -> /
  RewriteRule ^index$ / [R=301,L]

  # Never serve internal folders
  RewriteRule ^(includes|source|src|tools)(/|$) - [F,L]

  # ---- Clean URLs (no .html anywhere) ----
  # Old/typed .html addresses permanently redirect to the clean URL (only real browser requests)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # Trailing slash on a page -> no slash  (/about/ -> /about), but not for real folders like /admin/
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Blog articles: server-rendered by PHP at  /blog/<slug>
  RewriteRule ^blog/([a-z0-9-]+)$ blog-render/post.php?slug=$1 [L,QSA]
  RewriteRule ^blog-sitemap\.xml$ blog-render/sitemap.php [L]

  # Serve /page from page.html internally
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Block sensitive files
<FilesMatch "(^\.|\.(md|log|ini|sh|ps1|sql|json\.bak)$|composer\.(json|lock))">
  Require all denied
</FilesMatch>
<Files "site.webmanifest">
  Require all granted
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # Safe baseline CSP: blocks plugins, clickjacking, <base> hijacking and mixed content without
  # restricting the scripts Google Tag Manager needs to load.
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
  Header always unset X-Powered-By
  # CSS/JS are versioned (?v=…) so they can be cached for a year; images for 30 days.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
